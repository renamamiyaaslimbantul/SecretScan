ignored:
  - .git
  - node_modules
  - .venv
  - venv
  - bin
  - obj
  - vendor
  - dist
  - build
  - generated

excluded_patterns:
  - '^SAFE_[A-Z0-9_]+$'

minimum_confidence: 70
hook_minimum_confidence: 90
output: text
max_file_size: 10485760

custom_rules:
  - name: Internal Service Token
    pattern: 'INT_[A-Z0-9]{20}'
    confidence: 95
